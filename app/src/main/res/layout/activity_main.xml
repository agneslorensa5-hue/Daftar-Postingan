<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F5F8">

    <!-- HEADER JUDUL -->
    <TextView
        android:id="@+id/tvJudulHalaman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Postingan"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#19192F"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:paddingEnd="24dp" />

    <!-- STATUS JUMLAH POSTINGAN -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status"
        android:text="Memuat postingan..."
        android:textColor="#16452F"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp" />

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- TOMBOL ULANG -->
    <Button
        android:id="@+id/btnUlang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Coba Lagi"
        android:visibility="gone" />

    <!-- DAFTAR POSTINGAN -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

</LinearLayout>
