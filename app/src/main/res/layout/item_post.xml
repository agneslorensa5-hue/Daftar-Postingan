<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_post_card"
    android:padding="18dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvIsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POSTINGAN"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#268052"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvJudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Judul Postingan"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#172344"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Post #1 - User 1"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk untuk membaca selengkapnya"
        android:textSize="12sp"
        android:textColor="#268052"
        android:layout_marginTop="8dp" />

</LinearLayout>
